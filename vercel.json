{
  "installCommand": "npm install && cd backend && npm install && cd ../web && npm install",
  "buildCommand": "cd backend && npm run build && cd ../web && npm run build && cp public/landing.html dist/landing.html",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/", "destination": "/landing.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/upgrade", "destination": "/index.html" },
    { "source": "/payment/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}


